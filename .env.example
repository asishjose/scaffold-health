# Copy to .env and fill in real values before running docker compose up.
# Inside docker compose, api/worker reach db/redis by service name on the
# internal network — these are NOT the host-mapped ports (5433/6380).

DATABASE_URL=postgresql+psycopg2://scaffold:scaffold@db:5432/scaffold
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Single shared code therapists must supply at signup (single-clinic MVP).
CLINIC_REGISTRATION_CODE=DEV-CLINIC-CODE

# Free-tier key from https://console.groq.com/keys — primary provider for
# fact extraction and brief generation (Milestone 6 onward).
GROQ_API_KEY=

# Free-tier key from https://aistudio.google.com/apikey — sole provider for
# embeddings (Groq has no embeddings API), and fallback provider for the
# Groq-backed calls above if Groq fails.
GEMINI_API_KEY=

# Comma-separated origins allowed to call the API cross-origin. In local dev
# this isn't hit (Vite proxy keeps traffic same-origin); in production, set
# this to the real Static Web Apps domain.
CORS_ALLOWED_ORIGINS=https://PLACEHOLDER.azurestaticapps.net

# "local" (default) writes uploaded PDFs to DOCUMENTS_STORAGE_DIR on whichever
# machine handles the request — fine in docker-compose where api/worker share
# a filesystem. Once they run on separate hosts (Container Apps API + VM
# worker), set STORAGE_BACKEND=azure_blob and fill in the two vars below —
# there's no disk shared between those hosts otherwise.
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
DOCUMENTS_BLOB_CONTAINER=documents
